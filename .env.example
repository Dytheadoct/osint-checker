# Флаг, который получает решивший задание
FLAG=ACTF{change_me}

# Эталонная точка (десятичные градусы) и допустимый радиус в метрах.
# Замени нули на реальные координаты, иначе эталоном будет точка 0, 0.
TARGET_LAT=0.000000
TARGET_LON=0.000000
RADIUS_M=10

# Порт на хосте, на котором будет доступен чекер
PUBLIC_PORT=8080

# Защита от перебора
# Неверных попыток до первой блокировки
FREE_TRIES=5
# Минимальная пауза между попытками с одного адреса
MIN_INTERVAL=2s
# Первая блокировка, дальше удваивается за каждую следующую ошибку
LOCK_BASE=30s
# Потолок блокировки
LOCK_MAX=1h
# Сколько тишины нужно, чтобы счётчик ошибок обнулился
DECAY=1h
# Потолок попыток в минуту на весь сервис
GLOBAL_PER_MIN=300

# 1 только если перед контейнером стоит свой reverse proxy, который дописывает
# реальный адрес клиента в конец X-Forwarded-For. Иначе заголовок можно подделать.
TRUST_PROXY=0
